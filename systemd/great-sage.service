[Unit]
Description=The Great Sage desktop assistant
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/The-GREAT-SAGE-master
ExecStart=/usr/bin/bash %h/The-GREAT-SAGE-master/great-sage.sh run
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
